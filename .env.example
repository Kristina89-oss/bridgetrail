# Free key from https://etherscan.io/apis — used for the unified Etherscan V2
# multichain API (Ethereum, Arbitrum, Optimism, Base, Polygon, BSC, Avalanche, ...).
# Required only for recursive multi-hop tracing (looking up an address's
# subsequent transactions). A single-hop lookup of one tx hash works without it.
ETHERSCAN_API_KEY=

# Optional: override the public Solana RPC endpoint used for Solana tx history.
# Defaults to https://api.mainnet-beta.solana.com, which is rate-limited.
SOLANA_RPC_URL=
